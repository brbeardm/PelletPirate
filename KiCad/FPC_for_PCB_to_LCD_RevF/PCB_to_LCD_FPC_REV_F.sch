$Descr A4 11693 8268
Sheet 1 1
Title "PCB to LCD FPC Extension REV F"
Comment1 "J1 FRONT, male gold fingers BACK"
Comment2 "39 pin 0.30 mm; PRE-DFM"
$EndDescr
$Comp
L CONN_01X39 J1
U 1 1 5F000001
P 3000 3900
F 0 "J1" H 3000 5950 50  0000 C CNN
F 1 "FH26W-39S-0.3SHW(60)_FRONT" H 3000 1850 50  0000 C CNN
	1    3000 3900
	1 0 0 -1
$EndComp
$Comp
L CONN_01X39 J2
U 1 1 5F000002
P 7000 3900
F 0 "J2" H 7000 5950 50  0000 C CNN
F 1 "INTEGRAL_MALE_FPC_39P_BACK" H 7000 1850 50  0000 C CNN
	1    7000 3900
	-1 0 0 -1
$EndComp
