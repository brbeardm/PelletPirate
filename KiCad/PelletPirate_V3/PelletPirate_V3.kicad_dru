(version 1)

(rule "mains-to-lv"
    (condition "A.NetClass == 'MAINS' && B.NetClass != 'MAINS'")
    (constraint clearance (min 1.0mm)))

(rule "mains-to-earth"
    (condition "A.NetClass == 'MAINS' && B.NetName == 'Earth'")
    (constraint clearance (min 1.0mm)))

(rule "PS1-internal"
      (condition "A.memberOfFootprint('PS1') && B.memberOfFootprint('PS1')")
      (constraint clearance)
      (severity ignore))

(rule "PS1-edge"
      (condition "A.memberOfFootprint('PS1') || B.memberOfFootprint('PS1')")
      (constraint edge_clearance (min 0.25mm)))

(rule "mains-to-moc-nc"
      (condition "A.NetClass == 'MAINS' && B.NetName == 'unconnected-(MOC*'")
      (constraint clearance (min 0.3mm)))
